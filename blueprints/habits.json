{
  "id": "habits",
  "version": 2,
  "name": "Habits",
  "description": "Habit and fitness project with tracker, metrics and goals.",
  "required_capabilities": [],
  "work_items": [
    {
      "id": "practice",
      "name": "Practice",
      "initial_state": "planned",
      "states": [
        "planned",
        "active",
        "paused",
        "completed"
      ],
      "fields": [
        {
          "id": "activity",
          "kind": {
            "type": "text"
          },
          "required": true
        },
        {
          "id": "weekly_target",
          "kind": {
            "type": "integer"
          },
          "required": false,
          "default": 3
        },
        {
          "id": "check_in_required",
          "kind": {
            "type": "boolean"
          },
          "required": false,
          "default": true
        }
      ],
      "transitions": [
        {
          "from": "planned",
          "to": "active"
        },
        {
          "from": "active",
          "to": "paused"
        },
        {
          "from": "paused",
          "to": "active"
        },
        {
          "from": "active",
          "to": "completed"
        }
      ]
    },
    {
      "id": "check_in",
      "name": "Check-in",
      "initial_state": "due",
      "states": [
        "due",
        "recorded"
      ],
      "fields": [
        {
          "id": "notes",
          "kind": {
            "type": "text"
          },
          "required": false,
          "default": ""
        },
        {
          "id": "performed",
          "kind": {
            "type": "boolean"
          },
          "required": false,
          "default": false
        }
      ],
      "transitions": [
        {
          "from": "due",
          "to": "recorded"
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "starter",
      "name": "Habit starter",
      "items": [
        {
          "key": "habit",
          "kind": "practice",
          "properties": {
            "activity": "Choose an activity"
          }
        }
      ]
    }
  ],
  "views": [
    {
      "id": "overview",
      "title": "Habit overview",
      "description": "Recurring practice, observations and goals.",
      "layout": {
        "type": "grid",
        "columns": 2
      },
      "components": [
        {
          "id": "habits",
          "type": "habit_tracker",
          "source": "habits",
          "title": "Habits"
        },
        {
          "id": "metrics",
          "type": "metric_history",
          "source": "metrics",
          "title": "Metrics"
        },
        {
          "id": "project",
          "type": "detail",
          "source": "project",
          "title": "Project"
        },
        {
          "id": "goals",
          "type": "milestone_progress",
          "source": "milestones",
          "title": "Goals"
        }
      ]
    },
    {
      "id": "tracker",
      "title": "Tracker",
      "description": "Record an occurrence through the authorized habit command.",
      "layout": {
        "type": "vertical"
      },
      "components": [
        {
          "id": "habits",
          "type": "habit_tracker",
          "source": "habits",
          "title": "Habit tracker"
        },
        {
          "id": "notes",
          "type": "text",
          "title": "Recording occurrences",
          "text": "Select a habit and press Space to record an occurrence. Values are queued for authoritative acceptance; a pending record is not proof of completion."
        }
      ]
    },
    {
      "id": "metrics",
      "title": "Metrics",
      "description": "Metric targets and observations.",
      "layout": {
        "type": "vertical"
      },
      "components": [
        {
          "id": "history",
          "type": "metric_history",
          "source": "metrics",
          "title": "Metric history"
        },
        {
          "id": "table",
          "type": "table",
          "source": "metrics",
          "columns": [
            "id",
            "latest",
            "target"
          ],
          "limit": 50,
          "title": "Metrics"
        }
      ]
    },
    {
      "id": "goals",
      "title": "Goals",
      "description": "Goal progress and supporting tasks.",
      "layout": {
        "type": "grid",
        "columns": 2
      },
      "components": [
        {
          "id": "milestones",
          "type": "milestone_progress",
          "source": "milestones",
          "title": "Goals"
        },
        {
          "id": "done",
          "type": "metric",
          "source": "tasks",
          "aggregate": "count",
          "filter": {
            "status": "done"
          },
          "title": "Completed tasks"
        },
        {
          "id": "tasks",
          "type": "task_list",
          "source": "tasks",
          "limit": 10,
          "title": "Tasks"
        }
      ]
    }
  ]
}
