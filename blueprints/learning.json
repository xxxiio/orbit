{
  "id": "learning",
  "version": 2,
  "name": "Learning",
  "description": "Learning project with lessons, practice, progress and assessments.",
  "required_capabilities": [],
  "work_items": [
    {
      "id": "lesson",
      "name": "Lesson",
      "initial_state": "planned",
      "states": [
        "planned",
        "studying",
        "practicing",
        "assessment",
        "mastered"
      ],
      "fields": [
        {
          "id": "topic",
          "kind": {
            "type": "text"
          },
          "required": true
        },
        {
          "id": "minutes",
          "kind": {
            "type": "integer"
          },
          "required": false,
          "default": 30
        },
        {
          "id": "difficulty",
          "kind": {
            "type": "choice",
            "options": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "required": false,
          "default": "intermediate"
        }
      ],
      "transitions": [
        {
          "from": "planned",
          "to": "studying"
        },
        {
          "from": "studying",
          "to": "practicing"
        },
        {
          "from": "practicing",
          "to": "assessment"
        },
        {
          "from": "assessment",
          "to": "practicing"
        },
        {
          "from": "assessment",
          "to": "mastered"
        }
      ]
    },
    {
      "id": "assessment",
      "name": "Assessment",
      "initial_state": "planned",
      "states": [
        "planned",
        "ready",
        "evaluated"
      ],
      "fields": [
        {
          "id": "subject",
          "kind": {
            "type": "text"
          },
          "required": true
        },
        {
          "id": "passed",
          "kind": {
            "type": "boolean"
          },
          "required": false,
          "default": false
        }
      ],
      "transitions": [
        {
          "from": "planned",
          "to": "ready"
        },
        {
          "from": "ready",
          "to": "evaluated"
        },
        {
          "from": "evaluated",
          "to": "ready"
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "first_course",
      "name": "Start a course",
      "items": [
        {
          "key": "lesson_1",
          "kind": "lesson",
          "properties": {
            "topic": "Introduction"
          }
        },
        {
          "key": "lesson_2",
          "kind": "lesson",
          "properties": {
            "topic": "Practice"
          },
          "prerequisites": [
            "lesson_1"
          ]
        },
        {
          "key": "assessment",
          "kind": "assessment",
          "properties": {
            "subject": "Course assessment"
          },
          "prerequisites": [
            "lesson_2"
          ]
        }
      ]
    }
  ],
  "views": [
    {
      "id": "overview",
      "title": "Learning overview",
      "description": "Lessons, practice tasks and assessment state.",
      "layout": {
        "type": "grid",
        "columns": 2
      },
      "components": [
        {
          "id": "lessons",
          "type": "metric",
          "source": "work_items",
          "aggregate": "count",
          "filter": {
            "kind": "lesson"
          },
          "title": "Lessons"
        },
        {
          "id": "assessments",
          "type": "metric",
          "source": "work_items",
          "aggregate": "count",
          "filter": {
            "kind": "assessment"
          },
          "title": "Assessments"
        },
        {
          "id": "tasks",
          "type": "task_list",
          "source": "tasks",
          "limit": 10,
          "title": "Study tasks"
        },
        {
          "id": "project",
          "type": "detail",
          "source": "project",
          "title": "Project"
        }
      ]
    },
    {
      "id": "lessons",
      "title": "Lessons",
      "description": "Lesson and assessment workflow.",
      "layout": {
        "type": "vertical"
      },
      "components": [
        {
          "id": "board",
          "type": "kanban",
          "source": "work_items",
          "group_by": "state",
          "limit": 100,
          "title": "Lesson workflow"
        },
        {
          "id": "table",
          "type": "table",
          "source": "work_items",
          "columns": [
            "title",
            "kind",
            "state"
          ],
          "limit": 100,
          "title": "Lessons"
        }
      ]
    },
    {
      "id": "tasks",
      "title": "Tasks",
      "description": "Project study tasks with readiness and dependencies.",
      "layout": {
        "type": "vertical"
      },
      "components": [
        {
          "id": "list",
          "type": "task_list",
          "source": "tasks",
          "title": "Study tasks"
        }
      ]
    },
    {
      "id": "progress",
      "title": "Progress",
      "description": "Progress signals derived from accepted tasks and milestones.",
      "layout": {
        "type": "grid",
        "columns": 2
      },
      "components": [
        {
          "id": "done",
          "type": "metric",
          "source": "tasks",
          "aggregate": "count",
          "filter": {
            "status": "done"
          },
          "title": "Completed tasks"
        },
        {
          "id": "milestones",
          "type": "milestone_progress",
          "source": "milestones",
          "title": "Milestones"
        },
        {
          "id": "schedule",
          "type": "timeline",
          "source": "schedule",
          "title": "Practice schedule"
        }
      ]
    }
  ]
}
