{
  "id": "research",
  "version": 2,
  "name": "Research",
  "description": "Research project with hypotheses, evidence, workflow and references.",
  "required_capabilities": [],
  "work_items": [
    {
      "id": "hypothesis",
      "name": "Hypothesis",
      "initial_state": "proposed",
      "states": [
        "proposed",
        "investigating",
        "supported",
        "rejected"
      ],
      "fields": [
        {
          "id": "question",
          "kind": {
            "type": "text"
          },
          "required": true
        },
        {
          "id": "confidence",
          "kind": {
            "type": "choice",
            "options": [
              "unknown",
              "low",
              "medium",
              "high"
            ]
          },
          "required": false,
          "default": "unknown"
        }
      ],
      "transitions": [
        {
          "from": "proposed",
          "to": "investigating"
        },
        {
          "from": "investigating",
          "to": "supported"
        },
        {
          "from": "investigating",
          "to": "rejected"
        },
        {
          "from": "supported",
          "to": "investigating"
        }
      ]
    },
    {
      "id": "experiment",
      "name": "Experiment",
      "initial_state": "designed",
      "states": [
        "designed",
        "running",
        "analysis",
        "reported"
      ],
      "fields": [
        {
          "id": "method",
          "kind": {
            "type": "text"
          },
          "required": true
        },
        {
          "id": "reproducible",
          "kind": {
            "type": "boolean"
          },
          "required": false,
          "default": false
        }
      ],
      "transitions": [
        {
          "from": "designed",
          "to": "running"
        },
        {
          "from": "running",
          "to": "analysis"
        },
        {
          "from": "analysis",
          "to": "reported"
        },
        {
          "from": "analysis",
          "to": "running"
        }
      ]
    }
  ],
  "templates": [
    {
      "id": "investigation",
      "name": "Investigation",
      "items": [
        {
          "key": "hypothesis",
          "kind": "hypothesis",
          "properties": {
            "question": "Define research question"
          }
        },
        {
          "key": "experiment",
          "kind": "experiment",
          "properties": {
            "method": "Define methodology"
          },
          "prerequisites": [
            "hypothesis"
          ]
        }
      ]
    }
  ],
  "views": [
    {
      "id": "overview",
      "title": "Research overview",
      "description": "Questions, experiments and evidence.",
      "layout": {
        "type": "grid",
        "columns": 2
      },
      "components": [
        {
          "id": "hypotheses",
          "type": "metric",
          "source": "work_items",
          "aggregate": "count",
          "filter": {
            "kind": "hypothesis"
          },
          "title": "Hypotheses"
        },
        {
          "id": "experiments",
          "type": "metric",
          "source": "work_items",
          "aggregate": "count",
          "filter": {
            "kind": "experiment"
          },
          "title": "Experiments"
        },
        {
          "id": "questions",
          "type": "list",
          "source": "work_items",
          "limit": 10,
          "title": "Research items"
        },
        {
          "id": "project",
          "type": "detail",
          "source": "project",
          "title": "Project"
        },
        {
          "id": "knowledge",
          "type": "knowledge_refs",
          "source": "knowledge",
          "limit": 10,
          "title": "Knowledge"
        }
      ]
    },
    {
      "id": "evidence",
      "title": "Evidence",
      "description": "Knowledge is global in Orbit; project views reference accepted notes.",
      "layout": {
        "type": "vertical"
      },
      "components": [
        {
          "id": "notes",
          "type": "table",
          "source": "knowledge",
          "columns": [
            "title",
            "kind",
            "status"
          ],
          "limit": 50,
          "title": "Evidence notes"
        },
        {
          "id": "references",
          "type": "knowledge_refs",
          "source": "knowledge",
          "limit": 50,
          "title": "References"
        }
      ]
    },
    {
      "id": "workflow",
      "title": "Workflow",
      "description": "Typed research work items and guarded transitions.",
      "layout": {
        "type": "vertical"
      },
      "components": [
        {
          "id": "board",
          "type": "kanban",
          "source": "work_items",
          "group_by": "state",
          "limit": 100,
          "title": "Research workflow"
        },
        {
          "id": "items",
          "type": "table",
          "source": "work_items",
          "columns": [
            "title",
            "kind",
            "state"
          ],
          "limit": 100,
          "title": "Work items"
        }
      ]
    },
    {
      "id": "references",
      "title": "References",
      "description": "Global knowledge references available to this project view.",
      "layout": {
        "type": "vertical"
      },
      "components": [
        {
          "id": "notes",
          "type": "list",
          "source": "knowledge",
          "limit": 100,
          "title": "Knowledge references"
        }
      ]
    }
  ]
}
